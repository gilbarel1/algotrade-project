        "jsonBody": "={{ JSON.stringify({ run_id: $('Start Run').first().json.run_id, ticker: $json.ticker, draft: $json.draft, critique: $json.critique, final: $json.final, sentiment: $json.sentiment, earnings: $json.earnings, technical: $json.technical, agent_status: $('Assemble Risk Input').itemMatching($itemIndex).json.agent_status }) }}",
        "options": {}
