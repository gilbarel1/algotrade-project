    {
      "parameters": {
        "jsCode": "// Risk Manager input (§6.2): the three agent outputs for one ticker.\n// agent_status (§4.2) is captured HERE, from the agents' own outputs — the Risk\n// Manager echoes back only the §6.3 summary panels, which carry no `status`.\nconst runId = $('Start Run').first().json.run_id;\nreturn $input.all().map((item) => {\n  const technical = item.json.technical || {};\n  const sentiment = item.json.sentiment || {};\n  const earnings = item.json.earnings || {};\n  const ticker = technical.ticker || sentiment.ticker || earnings.ticker;\n  if (!ticker) {\n    throw new Error('merged agent outputs carry no ticker - check the agent fan-out');\n  }\n  const agent_status = {\n    sentiment: sentiment.status || 'degraded',\n    earnings: earnings.status || 'degraded',\n    technical: technical.status || 'degraded',\n  };\n  return { json: { run_id: runId, ticker, sentiment, earnings, technical, agent_status } };\n});"
      },
