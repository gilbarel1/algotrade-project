    {
      "parameters": {
        "jsCode": "// The store call's response ({stored:1}) replaced the items, so re-emit the Risk\n// Manager outputs before looping back - they are what the report is built from.\nreturn $('Risk Manager').all().map((item) => ({ json: item.json }));"
      },
      "id": "code-carry-risk",
      "name": "Carry Risk Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2464, 560]
    },
    {
      "parameters": {
        "jsCode": "const start = $('Start Run').first().json;\nconst recommendations = $input.all().map((i) => i.json).filter((r) => r && r.ticker);\nconst counts = {};\nfor (const rec of recommendations) {\n  const call = (rec.final && rec.final.recommendation) || 'unknown';\n  counts[call] = (counts[call] || 0) + 1;\n}\nconst summary = Object.entries(counts).map((entry) => entry[1] + ' ' + entry[0]).join(', ') || 'no recommendations';\nreturn [{ json: { run_id: start.run_id, recommendations, summary } }];"
      },
      "id": "code-build-report",
      "name": "Build Report Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 0]
    },
