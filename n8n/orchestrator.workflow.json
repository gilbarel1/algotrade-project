        "url": "={{ $env.QUANT_SERVICE_URL }}/runs/finish",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, status: $json.status, report_path: $json.report_path }) }}",
        "options": {}
      },
      "id": "http-runs-finish",
