      "parameters": {
        "method": "POST",
        "url": "={{ $env.QUANT_SERVICE_URL }}/report",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, recommendations: $json.recommendations, summary: $json.summary }) }}",
        "options": {}
