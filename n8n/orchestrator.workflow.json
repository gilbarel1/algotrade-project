      "id": "http-costs-harvest",
      "name": "Harvest Costs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1344, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Run status (§9.4): a degraded agent or a degraded cost harvest degrades the run;\n// a missing report path is an error. No silent fallbacks.\nconst start = $('Start Run').first().json;\nconst payload = $('Build Report Payload').first().json;\nconst report = $('Render Report').first().json || {};\nconst harvest = $json || {};\n\nconst recommendations = payload.recommendations || [];\nconst anyDegraded = recommendations.some((rec) =>\n  rec.status === 'degraded' ||\n  ['sentiment', 'earnings', 'technical'].some((k) => rec[k] && rec[k].status === 'degraded')\n);\nconst reportPath = report.pdf_path || null;\nconst harvestDegraded = String(harvest.summary || '').startsWith('degraded');\n\nlet status = 'ok';\nif (!reportPath) {\n  status = 'error';\n} else if (anyDegraded || harvestDegraded) {\n  status = 'degraded';\n}\n\nreturn [{\n  json: {\n    run_id: start.run_id,\n    status,\n    report_path: reportPath,\n    tickers: recommendations.length,\n    cost_summary: harvest.summary || null,\n  },\n}];"
      },
      "id": "code-assess-run",
      "name": "Assess Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1568, 0]
    },
    {
