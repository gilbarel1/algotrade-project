    {
      "parameters": {
        "jsCode": "// One item per ticker. The watchlist and the window parameters come from\n// /runs/start (config/universe.yaml, §4.4) — never hardcoded in the workflow.\nconst run = $json;\nconst watchlist = run.watchlist || [];\nif (!watchlist.length) {\n  throw new Error('/runs/start returned an empty watchlist - check config/universe.yaml (4.4)');\n}\nreturn watchlist.map((ticker) => ({\n  json: {\n    run_id: run.run_id,\n    ticker,\n    window_minutes: run.window_minutes,\n    window_days: run.window_days,\n    lookback_days: run.lookback_days,\n  },\n}));"
      },
