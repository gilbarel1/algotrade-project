# Copy to .env and fill in real values. Only this example file is committed; .env is gitignored.
# `npm run setup` copies this file for you; `npm run dev` loads .env into BOTH processes
# (the quant service and n8n) — you never need to export these by hand.

OPENROUTER_API_KEY=your-openrouter-key-here        # all LLM access (paste into the n8n credential too)
NEWSAPI_API_KEY=your-newsapi-key-here              # English news
ALPHAVANTAGE_API_KEY=your-alphavantage-key-here    # OHLC backup
QUANT_SERVICE_URL=http://127.0.0.1:8000            # 127.0.0.1, not localhost (Node resolves ::1 first, uvicorn binds IPv4). host.docker.internal:8000 if n8n is in Docker. The runner derives the uvicorn port from this.
N8N_API_URL=http://localhost:5678                  # n8n REST API — read by /costs/harvest (§9.4)
N8N_API_KEY=your-n8n-api-key-here                  # n8n Settings -> n8n API -> create key; token usage is only exposed there
N8N_CHAT_WEBHOOK_URL=                              # §6.5 chat front end -> n8n Chat Trigger. Import+activate n8n/chat_assistant.workflow.json, open the Chat Trigger node, copy its Production URL (ends in /chat). Unset = the frontend says so instead of answering.
FRONTEND_PORT=8001                                 # port for the chat front end (frontend/app.py); npm run dev serves it here
DUCKDB_PATH=quant_service/store.duckdb             # DuckDB cache/persistence file (relative to the repo root; the runner absolutises it)
REPORT_DIR=reports                                 # generated PDFs land here (relative to the repo root)
TZ=Asia/Jerusalem                                  # OS/Node clock: store UTC, render Asia/Jerusalem
GENERIC_TIMEZONE=Asia/Jerusalem                    # n8n cron timezone — REQUIRED for schedule_cron to fire on TASE hours. n8n evaluates Schedule Trigger crons in GENERIC_TIMEZONE (NOT TZ); unset it defaults to America/New_York and the schedule fires at the wrong hours.
HF_HOME=.hf_cache                                  # local Hugging Face cache (relative to the repo root)
# TASE_GATE_FAKE_NOW=2026-07-17T12:00:00+03:00     # DEV-ONLY: pins the orchestrator's TASE-hours gate to a fixed instant so the outside-hours branch is testable. Leave unset in production.
