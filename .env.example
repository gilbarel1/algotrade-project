# Copy to .env and fill in real values. Only this example file is committed; .env is gitignored.

OPENROUTER_API_KEY=your-openrouter-key-here        # all LLM access
NEWSAPI_API_KEY=your-newsapi-key-here              # English news
ALPHAVANTAGE_API_KEY=your-alphavantage-key-here    # OHLC backup
QUANT_SERVICE_URL=http://localhost:8000            # http://localhost:8000 (or host.docker.internal:8000 if n8n is in Docker)
N8N_API_URL=http://localhost:5678                  # n8n REST API — read by /costs/harvest (§9.4)
N8N_API_KEY=your-n8n-api-key-here                  # n8n Settings -> n8n API -> create key; token usage is only exposed there
DUCKDB_PATH=quant_service/store.duckdb             # DuckDB cache/persistence file
REPORT_DIR=reports                                 # generated PDFs land here
TZ=Asia/Jerusalem                                  # store UTC, render Asia/Jerusalem
HF_HOME=.hf_cache                                  # local Hugging Face cache (avoids re-downloads)
